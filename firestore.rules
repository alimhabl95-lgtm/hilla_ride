rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {

      return request.auth != null;

    }



    function isSelf(userId) {

      return signedIn() && request.auth.uid == userId;

    }



    function userDoc() {

      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;

    }



    function isManager() {

      return signedIn()

        && exists(/databases/$(database)/documents/users/$(request.auth.uid))

        && userDoc().role == 'manager';

    }



    function isAssistant() {

      return signedIn()

        && exists(/databases/$(database)/documents/users/$(request.auth.uid))

        && userDoc().role == 'assistant';

    }



    function isAdminUser() {

      return isManager() || isAssistant();

    }



    function hasPermission(permission) {

      return isManager()

        || (

          isAssistant()

          && userDoc().permissions is list

          && permission in userDoc().permissions

        );

    }



    match /users/{userId} {

      allow read: if signedIn();

      allow create: if isSelf(userId)

        && (

          request.resource.data.role in ['customer', 'driver', 'manager']

          || (

            request.resource.data.role == 'assistant'

            && request.resource.data.isBlocked == true

            && request.resource.data.approvalStatus == 'pending'

            && (

              !('permissions' in request.resource.data)

              || request.resource.data.permissions.size() == 0

            )

          )

        );

      allow update: if isManager()

        || (

          isSelf(userId)

          && !request.resource.data.diff(resource.data).affectedKeys()

            .hasAny(['isBlocked', 'cancelledRidesCount', 'blockedAt', 'role', 'permissions', 'createdBy'])

        )

        || (

          isSelf(userId)

          && request.resource.data.diff(resource.data).affectedKeys()

            .hasOnly(['cancelledRidesCount'])

        )

        || (

          isManager()

          && resource.data.role == 'assistant'

          && request.resource.data.diff(resource.data).affectedKeys()

            .hasOnly(['permissions', 'updatedAt', 'isBlocked', 'blockedAt', 'approvalStatus', 'approvedAt'])

        )

        || (

          isSelf(userId)

          && request.resource.data.diff(resource.data).affectedKeys()

            .hasOnly(['activeSessionId', 'activeSessionUpdatedAt'])

        )

        || (

          signedIn()

          && request.resource.data.diff(resource.data).affectedKeys()

            .hasOnly(['promoRidesUsed'])

        );

      allow delete: if (isManager() || (isAssistant() && hasPermission('customers')))
        && resource.data.role == 'customer'
        || (isManager() || (isAssistant() && hasPermission('allDrivers')))
        && resource.data.role == 'driver';

    }



    match /users/{userId}/saved_places/{placeId} {

      allow read: if isSelf(userId) || isManager()
        || (isAssistant() && hasPermission('customers'));

      allow create, update: if isSelf(userId);

      allow delete: if isManager()
        || (isAssistant() && hasPermission('customers'));

    }



    match /released_phones/{phoneKey} {

      allow read: if true;

      allow create, update: if isManager()
        || (isAssistant() && hasPermission('customers'))
        || (isAssistant() && hasPermission('allDrivers'));

      allow delete: if isManager()
        || (isAssistant() && hasPermission('customers'))
        || (isAssistant() && hasPermission('allDrivers'))
        || (request.auth != null
          && resource.data.phone is string
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
            == resource.data.phone);

    }

    match /otp_sessions/{phoneKey} {
      allow read, write: if false;
    }



    match /drivers/{driverId} {

      allow read: if signedIn();

      allow create: if isSelf(driverId) || isAdminUser();

      allow update: if isAdminUser()

        || (

          isSelf(driverId)

          && !request.resource.data.diff(resource.data).affectedKeys()

            .hasAny([
              'isRemoved', 'removedAt', 'approvalStatus', 'reviewedAt',
              'isBlocked', 'blockedAt',
              'walletBalanceIqd', 'walletStatus', 'walletUpdatedAt'
            ])

        )

        || (

          isSelf(driverId)

          && request.resource.data.diff(resource.data).affectedKeys()

            .hasOnly(['cancelledRidesCount'])

        )

        || (

          signedIn()

          && request.resource.data.diff(resource.data).affectedKeys()

            .hasOnly(['monthlyRideCount', 'monthlyMonthKey'])

        );

      allow delete: if isManager()
        || (isAssistant() && hasPermission('allDrivers'));

    }

    match /drivers/{driverId}/profit_settlements/{settlementId} {
      allow read: if signedIn();
      allow create: if isAdminUser();
      allow delete: if isManager();
    }

    match /drivers/{driverId}/bonuses/{bonusId} {
      allow read: if signedIn();
      allow create, update: if isAdminUser();
      allow delete: if isManager();
    }

    // Live map presence for customers (ride + future delivery services).
    // Writes come from Cloud Functions (Admin SDK). Clients may only read.
    match /mapPresence/{providerId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /rides/{rideId} {

      allow read: if signedIn();

      allow create, update: if signedIn();

    }



    match /config/pricing {

      allow read: if signedIn();

      allow write: if hasPermission('pricing');

    }

    match /config/wallet {
      allow read: if signedIn();
      allow write: if false; // Cloud Functions only
    }

    match /walletLedger/{entryId} {
      allow read: if signedIn()
        && (
          isAdminUser()
          || resource.data.driverId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /walletRechargeRequests/{requestId} {
      allow read: if signedIn()
        && (
          isAdminUser()
          || resource.data.driverId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /serviceCountries/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /serviceProvinces/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /serviceDistricts/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /serviceSubDistricts/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /rewardCampaigns/{campaignId} {
      allow read: if signedIn();
      allow write: if false; // Cloud Functions only
    }

    match /rewardProgress/{progressId} {
      allow read: if signedIn()
        && (
          isAdminUser()
          || resource.data.driverId == request.auth.uid
        );
      allow write: if false;
    }

    match /rewardGrants/{grantId} {
      allow read: if signedIn()
        && (
          isAdminUser()
          || resource.data.driverId == request.auth.uid
        );
      allow write: if false;
    }

    match /rewardAuditLogs/{logId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    match /drivers/{driverId}/activeRewards/{rewardId} {
      allow read: if signedIn()
        && (isAdminUser() || request.auth.uid == driverId);
      allow write: if false;
    }

    match /businesses/{businessId} {
      allow read: if signedIn()
        && (
          isAdminUser()
          || resource.data.status == 'live'
          || resource.data.ownerUid == request.auth.uid
        );
      allow write: if false;

      match /categories/{categoryId} {
        allow read: if signedIn();
        allow write: if false;
      }
      match /products/{productId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /businessOrders/{orderId} {
      allow read: if signedIn()
        && (
          isAdminUser()
          || resource.data.customerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId
               == resource.data.businessId
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
            && resource.data.status in ['ready', 'outForDelivery']
          )
        );
      allow write: if false;
    }

    match /config/businessTypes {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/{configId} {

      allow read: if signedIn()

        && (

          configId.matches('pricing_.+')

          || configId.matches('promo_.+')

        );

      allow write: if (

        hasPermission('pricing')

        && configId.matches('pricing_.+')

      ) || (

        hasPermission('promoCodes')

        && configId.matches('promo_.+')

      );

    }



    match /config/monthly_prize {

      allow read: if signedIn();

      allow write: if hasPermission('monthlyLeaderboard');

    }

    match /config/ride_counter {

      allow read: if signedIn();

      allow create, update: if signedIn();

    }



    match /config/pricing/cities/{districtId} {

      allow read: if signedIn();

      allow write: if hasPermission('pricing');

    }



    match /config/support {

      allow read: if signedIn();

      allow write: if isManager() || hasPermission('supportInbox');

    }



    match /config/commission {

      allow read: if signedIn();

      allow write: if hasPermission('earnings');

    }



    match /rides/{rideId}/messages/{messageId} {

      allow read: if signedIn();

      allow create: if signedIn();

    }



    match /support_messages/{messageId} {

      allow read: if signedIn()

        && (resource.data.userId == request.auth.uid || isAdminUser());

      allow create: if signedIn()

        && (

          (request.resource.data.userId == request.auth.uid && !request.resource.data.isFromManager)

          || hasPermission('supportInbox')

        );

      allow update: if hasPermission('supportInbox');

    }

    match /announcements/{announcementId} {

      allow read: if signedIn() && (

        isAdminUser()

        || (

          resource.data.audience == 'customers'

          && userDoc().role == 'customer'

        )

        || (

          resource.data.audience == 'drivers'

          && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))

        )

      );

      allow create: if isManager()

        && request.resource.data.audience in ['drivers', 'customers']

        && request.resource.data.title is string

        && request.resource.data.title.size() > 0

        && request.resource.data.body is string

        && request.resource.data.body.size() > 0

        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;

    }

  }

}

